	["DictKey_ActionText_276"] = "Hornet 5-1: Tanker should be up ahead in 10.",
	["DictKey_ActionText_282"] = "Hornet 5-2: SAM picture still quiet?",
	["DictKey_ActionText_285"] = "Hornet 5-1: Picture update. Two MiGs scrambled. Twenty-five miles east.",
	["DictKey_ActionText_287"] = "Hornet 5-2: Weather’s getting uglier back west.",
	["DictKey_ActionText_289"] = "Hornet 5-1: Feels different once land drops off the scope.",
	["DictKey_ActionText_291"] = "Hornet 5-1: Mother TACAN’s coming alive. 60 miles.",
	["DictKey_ActionText_294"] = "",
	["DictKey_ActionText_296"] = "Hornet 5-2: Hey… give me Rad One for a second.",
	["DictKey_ActionText_298"] = "Hornet 5-1: …No way.",
	["DictKey_ActionText_299"] = "Hornet 5-1: I have no idea what they’re saying.",
	["DictKey_ActionText_300"] = "Hornet 5-2: Storm helps. Nobody sightseeing tonight.",
	["DictKey_ActionText_301"] = "Hornet 5-1: Yeah. Clouds doing us a favor for once.",
	["DictKey_ActionText_302"] = "Hornet 5-2: Radar picture’s clean so far.",
	["DictKey_ActionText_303"] = "Hornet 5-1: Enjoy it while it lasts. Russians don’t sleep.",
	["DictKey_ActionText_304"] = "Hornet 5-2: They just pretend not to see until they do.",
	["DictKey_ActionText_305"] = "Hornet 5-1: Fuel check.",
	["DictKey_ActionText_306"] = "Hornet 5-2: State 12.8.",
	["DictKey_ActionText_307"] = "",
	["DictKey_ActionText_308"] = "Hornet 5-1: It always does at night.",
	["DictKey_ActionText_309"] = "Hornet 5-2: Any chance of fog closer to the coast?",
	["DictKey_ActionText_310"] = "Hornet 5-1: Intel says maybe. Real world says definitely.",
	["DictKey_ActionText_311"] = "Hornet 5-2: Good thing we’re not landing anytime soon.",
	["DictKey_ActionText_312"] = "Hornet 5-1: Don’t say that out loud.",
	["DictKey_ActionText_313"] = "Hornet 5-2: Jet’s solid though.",
	["DictKey_ActionText_314"] = "Hornet 5-1: Yeah. Trust the machine. Don’t trust the sky.",
	["DictKey_ActionText_315"] = "Hornet 5-2: Copy. I could use the gas.\n",
	["DictKey_ActionText_316"] = "Hornet 5-1: Everyone always says that like it’s optional.",
	["DictKey_ActionText_317"] = "Hornet 5-2: Night, weather, long legs. I’m not gambling.",
	["DictKey_ActionText_318"] = "Hornet 5-1: Smart choice. Russians love thirsty jets.",
	["DictKey_ActionText_319"] = "Hornet 5-2: Texaco still north, right?",
	["DictKey_ActionText_320"] = "Hornet 5-1: Yeah. Turkish airspace. Friendly skies.",
	["DictKey_ActionText_321"] = "Hornet 5-2: Best kind.",
	["DictKey_ActionText_322"] = "",
	["DictKey_ActionText_323"] = "",
	["DictKey_ActionText_324"] = "Hornet 5-1: Copy. Same here.",
	["DictKey_ActionText_325"] = "Hornet 5-2: Copy. Fence in.",
	["DictKey_ActionText_326"] = "Hornet 5-1: Before we push, one more time. Target area’s dirty.\n",
	["DictKey_ActionText_327"] = "Hornet 5-2: AAA and SAMs. Briefed.",
	["DictKey_ActionText_328"] = "Hornet 5-1: Yeah. And don’t assume they’re where intel said. Assume more. If this turns chaotic, we don’t improvise. We execute.",
	["DictKey_ActionText_329"] = "Hornet 5-2: Two.",
	["DictKey_ActionText_330"] = "Hornet 5-1: AAA, pop-up SAM, or a MiG deciding he’s brave tonight… We don’t chase, we don’t fixate. If someone gets hit… same plan we briefed. Mark position. Last known heading. Don’t hover.",
	["DictKey_ActionText_331"] = "Hornet 5-2: Search and rescue comes later. Mission comes first.",
	["DictKey_ActionText_332"] = "Hornet 5-1: Yeah. Hard truth, but that’s the truth.",
	["DictKey_ActionText_333"] = "Hornet 5-2: Not my favorite part of the job.",
	["DictKey_ActionText_334"] = "Hornet 5-1: Nobody’s favorite. That’s why we keep it simple.\n",
	["DictKey_ActionText_335"] = "",
	["DictKey_ActionText_336"] = "Hornet 5-1: Fence check complete?",
	["DictKey_ActionText_337"] = "Hornet 5-2: Fence in. Systems green.",
	["DictKey_ActionText_338"] = "Hornet 5-1: Alright. From here on, minimal talk.",
	["DictKey_ActionText_339"] = "Hornet 5-2: Two. Locked in.",
	["DictKey_ActionText_340"] = "",
	["DictKey_ActionText_341"] = "",
	["DictKey_ActionText_342"] = "",
	["DictKey_ActionText_343"] = "",
	["DictKey_ActionText_344"] = "Hornet 5-1: Quiet doesn’t mean asleep.",
	["DictKey_ActionText_345"] = "Hornet 5-2: Migs are the wildcard.",
	["DictKey_ActionText_346"] = "Hornet 5-1: Incirlik CAP’s watching our back. Still, eyes open.",
	["DictKey_ActionText_347"] = "Hornet 5-2: You ever notice night flights feel longer?",
	["DictKey_ActionText_348"] = "Hornet 5-1: Because your brain has nothing to grab onto.",
	["DictKey_ActionText_349"] = "Hornet 5-2: Just instruments and static.",
	["DictKey_ActionText_35"] = "",
	["DictKey_ActionText_350"] = "Hornet 5-1: And your own thoughts. Worst part.",
	["DictKey_ActionText_351"] = "Hornet 5-2: After this, I’m not flying for a week.",
	["DictKey_ActionText_352"] = "Hornet 5-1: You say that every time.",
	["DictKey_ActionText_353"] = "Hornet 5-2: One day I’ll mean it.",
	["DictKey_ActionText_354"] = "Hornet 5-1: Alright. Eyes back outside.",
	["DictKey_ActionText_355"] = "Hornet 5-2: Two.",
	["DictKey_ActionText_356"] = "",
	["DictKey_ActionText_357"] = "",
	["DictKey_ActionText_358"] = "Hornet 5-2: Incirlik boys taking them?",
