	["DictKey_ActionText_700"] = "Hornet 5-1: Hornet-5, wilco.\n",
	["DictKey_ActionText_701"] = "Overlord: Hornet-5, Overlord. How copy?\n",
	["DictKey_ActionText_702"] = "",
	["DictKey_ActionText_704"] = "Hornet 5-1: Sir, apologies. We had an issue with the radio system and couldn’t get it sorted.\n",
	["DictKey_ActionText_705"] = "Overlord: An issue, huh?",
	["DictKey_ActionText_706"] = "Hornet 5-2: Yes sir, there was a prob—\n",
	["DictKey_ActionText_707"] = "Overlord: You shut up. I’m talking to your screw-up lead.\n",
	["DictKey_ActionText_708"] = "Hornet 5-2: Aye sir.\n",
	["DictKey_ActionText_709"] = "Overlord: Listen up, idiots. You can reach Washington on \"push button 2\". That’s all for tonight. But you remember one thing. \n\nYou screw up just this much, you’ll be flying a cargo plane full of rubber dog shit out of Hong Kong.\n",
	["DictKey_ActionText_710"] = "Hornet 5-1: Aye aye, sir.\nHornet 5-2: Aye aye, sir.\n",
