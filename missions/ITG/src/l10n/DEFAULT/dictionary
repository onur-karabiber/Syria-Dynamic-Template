	["DictKey_ActionText_595"] = "",
	["DictKey_ActionText_596"] = "Hornet 5-1: Out how?\n",
	["DictKey_ActionText_597"] = "Hornet 5-2: I’m gonna invest in a flight simulator.\n",
	["DictKey_ActionText_598"] = "Hornet 5-1: You sure about that. Sounds like a good way to go broke.\n",
	["DictKey_ActionText_599"] = "",
	["DictKey_ActionText_60"] = "",
	["DictKey_ActionText_600"] = "Hornet 5-2: Nah. No chance. I’ll make it look amazing. Crazy graphics. People will lose their minds. Base game’s free. Anyone can download it.\n",
	["DictKey_ActionText_601"] = "Hornet 5-1: Of course it is.\n",
	["DictKey_ActionText_602"] = "",
	["DictKey_ActionText_603"] = "Hornet 5-2: Then I sell the modules. One by one.\n",
	["DictKey_ActionText_604"] = "",
	["DictKey_ActionText_605"] = "",
	["DictKey_ActionText_606"] = "",
	["DictKey_ActionText_607"] = "Hornet 5-1: You really think people are that stupid. You’ll crank out a ton of modules, half-finished. Bugs everywhere. No time to fix anything before the next one drops.\n",
	["DictKey_ActionText_608"] = "Hornet 5-2: Relax. They’ll buy them anyway.\n",
	["DictKey_ActionText_609"] = "Hornet 5-1: You have a disturbingly low opinion of humanity.\n",
	["DictKey_ActionText_61"] = "",
	["DictKey_ActionText_610"] = "Hornet 5-2: I prefer the term optimistic.\n",
	["DictKey_ActionText_611"] = "Hornet 5-1: Remind me never to invest with you.\n",
	["DictKey_ActionText_612"] = "Hornet 5-2: Don’t worry. You won’t be an investor, you’ll be a customer, my friend. You’ll be the first one I sell to.\n",
	["DictKey_ActionText_613"] = "Hornet 5-2: Roger.",
	["DictKey_ActionText_614"] = "Overlord: Hornet-5, Overlord-1-1. Maintain present course, proceed to assigned destination.",
	["DictKey_ActionText_615"] = "",
	["DictKey_ActionText_616"] = "",
	["DictKey_ActionText_617"] = "Overlord: Do not exceed 340 knots. Stand by for switch to Magic on my call. Maintain radio silence until further notice.\n",
	["DictKey_ActionText_618"] = "Overlord: Hard deck FL220. Avoid civilian airways. Do not climb above FL240.\n",
	["DictKey_ActionText_621"] = "Hornet 5-2: Timer’s showing 1.5 Almost in.\n",
	["DictKey_ActionText_622"] = "Hornet 5-1: Copy. Eyes outside.",
	["DictKey_ActionText_623"] = "Hornet 5-2: AAA’s waking up. Random fire.\n",
	["DictKey_ActionText_624"] = "Hornet 5-1: Yeah. They know something’s wrong.\n",
	["DictKey_ActionText_625"] = "Hornet 5-2: Tracers everywhere. Nothing targeted yet.\n",
	["DictKey_ActionText_626"] = "Hornet 5-1: Ignore the noise. Stay on profile.\n",
	["DictKey_ActionText_627"] = "Hornet 5-2: Holding parameters.\n",
	["DictKey_ActionText_628"] = "Hornet 5-1: Stand by… almost there.\n",
	["DictKey_ActionText_629"] = "Hornet 5-1: Weapons free. Engage mission and rejoin.\n",
	["DictKey_ActionText_630"] = "Hornet 5-2: Two, engaging primary.",
	["DictKey_ActionText_631"] = "",
	["DictKey_ActionText_634"] = "",
	["DictKey_ActionText_636"] = "",
	["DictKey_ActionText_638"] = "",
	["DictKey_ActionText_640"] = "",
	["DictKey_ActionText_642"] = "",
	["DictKey_ActionText_643"] = "Hornet 5-1: 10 miles to Texaco. I’ll contact tanker on 252.1 Texaco TACAN is 21Y. We’re not making it home on current fuel. Planned offload is four thousand five hundred pounds. After refuel, we’ll rejoin and turn south.",
	["DictKey_ActionText_644"] = "Hornet 5-1: Fly to tanker.",
	["DictKey_ActionText_645"] = "Hornet 5-2: Two, moving.",
	["DictKey_ActionText_648"] = "Hornet 5-2: Look at that moon. Clouds look like a runway up here.\n",
	["DictKey_ActionText_649"] = "Hornet 5-1: Yeah. Nights like this almost make you forget the mess down below.\n",
	["DictKey_ActionText_650"] = "Hornet 5-2: Almost.\n",
	["DictKey_ActionText_651"] = "Hornet 5-1: Flying over Turkey always does that to me.\n",
	["DictKey_ActionText_652"] = "Hornet 5-2: Speaking of… you ever hear that Red Flag story about the Turkish guys.\n",
	["DictKey_ActionText_653"] = "Hornet 5-1: Which one.\n",
	["DictKey_ActionText_654"] = "Hornet 5-2: Late nineties. First time they show up. New faces.\n",
	["DictKey_ActionText_655"] = "Hornet 5-2: They get slotted red air, playing MiGs and Flankers.\n",
	["DictKey_ActionText_656"] = "Hornet 5-1: Against the whole Blue stack.\n",
	["DictKey_ActionText_657"] = "Hornet 5-2: Yeah. Like a hundred NATO jets.\n",
	["DictKey_ActionText_658"] = "Hornet 5-2: One of their F-16s goes up alone.\n",
	["DictKey_ActionText_659"] = "Hornet 5-2: Single sortie. Nine kills.\n",
	["DictKey_ActionText_660"] = "Hornet 5-1: Nine!\n",
	["DictKey_ActionText_661"] = "Hornet 5-2: Five Eagles, four Vipers. Walks out untouched.\n",
	["DictKey_ActionText_662"] = "Hornet 5-1: That’ll get attention.\n",
	["DictKey_ActionText_663"] = "Hornet 5-2: They start calling him: Tango-1\n",
	["DictKey_ActionText_664"] = "Hornet 5-2: \"Tango-1 Never Dies\".\n",
	["DictKey_ActionText_665"] = "Hornet 5-1: Sounds welcoming.\n",
	["DictKey_ActionText_666"] = "Hornet 5-1: I’ve heard a version of that.\n",
	["DictKey_ActionText_667"] = "Hornet 5-2: Another guy same exercise. Five kills, clean sortie.\n",
	["DictKey_ActionText_668"] = "Hornet 5-1: Red air doing red air things.",
	["DictKey_ActionText_669"] = "Hornet 5-2: All simulated, of course. Pods, tapes, the whole truth machine.\n",
	["DictKey_ActionText_67"] = "ALL VISITORS LANDED. CONGURATULATIONS!",
	["DictKey_ActionText_670"] = "Hornet 5-1: Doesn’t make it less impressive.\n",
	["DictKey_ActionText_671"] = "Hornet 5-2: Nope. Skill still counts.\n",
	["DictKey_ActionText_672"] = "Hornet 5-1: Good pilots are good pilots. Doesn’t matter where they’re from.\n",
	["DictKey_ActionText_673"] = "Hornet 5-2: Exactly. Sky doesn’t care about flags.\n",
	["DictKey_ActionText_674"] = "",
	["DictKey_ActionText_675"] = "Hornet 5-1: Just decisions.\n",
	["DictKey_ActionText_676"] = "Hornet 5-2: And timing.\n\n",
	["DictKey_ActionText_677"] = "Hornet 5-1: Alright. Enjoy the view while it lasts.\n",
	["DictKey_ActionText_678"] = "",
	["DictKey_ActionText_679"] = "Hornet 5-2: Copy. Moon’s on our wing.\n",
	["DictKey_ActionText_68"] = "",
	["DictKey_ActionText_680"] = "",
	["DictKey_ActionText_683"] = "Hornet 5-1: Alright. Back in Turkish airspace. Fence out.\n",
	["DictKey_ActionText_684"] = "Hornet 5-2: Copy. Fence out.\n",
	["DictKey_ActionText_686"] = "",
	["DictKey_ActionText_687"] = "Hornet 5-2: Two, in position.",
	["DictKey_ActionText_688"] = "GİRDİİİİİİİİİİİİİİİ",
