	["DictKey_ActionText_467"] = "Hornet 5-2: Not just sleeping. I’m setting conditions.\n",
	["DictKey_ActionText_468"] = "Hornet 5-1: Conditions?",
	["DictKey_ActionText_469"] = "Hornet 5-2: Two days. No wake-ups. No knocks. No emergencies unless the ship’s sinking.",
	["DictKey_ActionText_47"] = "",
	["DictKey_ActionText_470"] = "Hornet 5-1: You gonna put that in writing?",
	["DictKey_ActionText_471"] = "Hornet 5-2: I’m considering barricades.",
