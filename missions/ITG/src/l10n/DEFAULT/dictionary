	["DictKey_ActionText_473"] = "Hornet 5-2: Long, ugly, and way too personal.",
	["DictKey_ActionText_474"] = "Hornet 5-1: Still clean work.",
	["DictKey_ActionText_475"] = "Hornet 5-2: Yeah… which reminds me.",
	["DictKey_ActionText_476"] = "Hornet 5-2: I’ve got a standing bet with the ship’s doc.",
	["DictKey_ActionText_477"] = "Hornet 5-1: Of course you do.",
	["DictKey_ActionText_478"] = "Hornet 5-2: Julia. She said if we come back clean, no drama, she owes me.",
	["DictKey_ActionText_479"] = "Hornet 5-1: Owes you what?",
	["DictKey_ActionText_48"] = "",
	["DictKey_ActionText_480"] = "Hornet 5-2: Ticket and jersey. Arizona Diamondbacks.",
	["DictKey_ActionText_481"] = "Hornet 5-1: You’re kidding.",
	["DictKey_ActionText_482"] = "Hornet 5-2: Dead serious. Her words, not mine.",
	["DictKey_ActionText_483"] = "Hornet 5-1: That’s a weird incentive program.",
	["DictKey_ActionText_484"] = "Hornet 5-2: Hey, stress management is medical.",
	["DictKey_ActionText_485"] = "Hornet 5-1: Guess you’re getting your merch.",
	["DictKey_ActionText_486"] = "Hornet 5-2: Yeah. Assuming nobody messes this landing up.",
	["DictKey_ActionText_487"] = "Hornet 5-1: Don’t tempt fate.",
	["DictKey_ActionText_488"] = "Hornet 5-2: I’m done tempting anything tonight.",
	["DictKey_ActionText_489"] = "Hornet 5-1: Mother’s southwest. We’ll be back in the soup soon.",
	["DictKey_ActionText_49"] = "",
	["DictKey_ActionText_490"] = "Hornet 5-2: Copy. After that, I disappear.",
	["DictKey_ActionText_491"] = "Hornet 5-1: For two days.",
	["DictKey_ActionText_492"] = "Hornet 5-2: Minimum.",
	["DictKey_ActionText_493"] = "Hornet 5-1: Fair enough.",
	["DictKey_ActionText_494"] = "Hornet 5-2: Two.",
	["DictKey_ActionText_495"] = "",
	["DictKey_ActionText_496"] = "Hornet 5-2: Jesus! SEAD’s taking fire.\n",
	["DictKey_ActionText_497"] = "Hornet 5-1: F**k!\n",
	["DictKey_ActionText_498"] = "Hornet 5-2: Did you catch that? They nailed their #4.",
	["DictKey_ActionText_499"] = "Hornet 5-1: Alright. Easy. Stay with me. They’ll work it.\n",
	["DictKey_ActionText_50"] = "",
	["DictKey_ActionText_500"] = "Hornet 5-2: Christ… what kind of goddamn mess are we flying into tonight?",
	["DictKey_ActionText_501"] = "Hornet 5-1: Hold it together. We push, we do our job, we’re out.\n",
	["DictKey_ActionText_502"] = "",
	["DictKey_ActionText_503"] = "",
	["DictKey_ActionText_504"] = "Hornet-5-2: Two.\n",
	["DictKey_ActionText_51"] = "",
	["DictKey_ActionText_510"] = "Hornet 5-2: Man, look at all that civilian traffic out here.\n",
	["DictKey_ActionText_511"] = "Hornet 5-1: Yeah. That’s the weird part. Life keeps moving.\n",
	["DictKey_ActionText_512"] = "Hornet 5-1: Everyone’s fighting someone, but nobody’s officially at war.",
	["DictKey_ActionText_513"] = "Hornet 5-1: If this was a real shooting war, the sky would be empty.\n",
	["DictKey_ActionText_514"] = "Hornet 5-2: Exactly. No tourists in a war zone.\n",
	["DictKey_ActionText_515"] = "Hornet 5-2: Kind of feels like we’re just watching our own retirement fly by.\n",
	["DictKey_ActionText_516"] = "Hornet 5-1: Your what?\n",
	["DictKey_ActionText_517"] = "Hornet 5-2: Think about it. We’re not gonna be Navy pilots forever.\n",
	["DictKey_ActionText_518"] = "Hornet 5-2: No way we’re doing this till sixty.\n",
	["DictKey_ActionText_519"] = "Hornet 5-2: At some point we punch out, hang up the helmet.\n",
	["DictKey_ActionText_52"] = "",
	["DictKey_ActionText_520"] = "Hornet 5-2: Probably end up commercial, like everyone else.\n",
	["DictKey_ActionText_521"] = "Hornet 5-2: Airline life, early alarms, smiling at people with luggage.\n",
	["DictKey_ActionText_522"] = "Hornet 5-1: Yeah… but those bills back home don’t pay themselves, my friend.\n",
	["DictKey_ActionText_523"] = "Hornet 5-2: True. Missiles don’t either.\n",
	["DictKey_ActionText_524"] = "Hornet 5-1: Guess the jet time just turns into logbook time.\n",
	["DictKey_ActionText_525"] = "Hornet 5-2: Different cockpit, same sky.\n",
	["DictKey_ActionText_526"] = "Hornet 5-1: Yeah. Still beats a desk.\n",
	["DictKey_ActionText_527"] = "Hornet 5-2: No argument there.\n",
	["DictKey_ActionText_528"] = "",
	["DictKey_ActionText_529"] = "",
	["DictKey_ActionText_53"] = "",
	["DictKey_ActionText_530"] = "",
	["DictKey_ActionText_533"] = "Hornet 5-1: Hey… hold on a second. What was that new chart again. We’ve got time, let’s walk it once.\n",
	["DictKey_ActionText_534"] = "Hornet 5-2: Yeah, good call. Go ahead.\n",
	["DictKey_ActionText_535"] = "Hornet 5-1: Alright. R206, 25 NM fix.",
	["DictKey_ActionText_536"] = "Hornet 5-1: Assigned altitude’s gonna be 10 thousand feet.\n",
	["DictKey_ActionText_537"] = "Hornet 5-1: Likely a parallel entry into the hold. Nothing fancy.\n",
	["DictKey_ActionText_538"] = "Hornet 5-1: Fuel check while we’re at it. If anything goes sideways, Arco-5 recovery tanker’s up.\n",
	["DictKey_ActionText_539"] = "Hornet 5-2: Copy.\n",
	["DictKey_ActionText_54"] = "",
	["DictKey_ActionText_540"] = "Hornet 5-1: IAF, 10 thousand feet, 300 knots G/S. That part matters.\n",
	["DictKey_ActionText_541"] = "Hornet 5-1: Complete the hold, then commence.\n",
	["DictKey_ActionText_542"] = "Hornet 5-1: Down to 12 hundred feet on the descent.\n",
	["DictKey_ActionText_543"] = "Hornet 5-1: At DME14, 30 degrees right bank, put mother on the 9 o’clock.\n",
	["DictKey_ActionText_544"] = "Hornet 5-1: Hold that and fly the 12 NM arc.\n",
	["DictKey_ActionText_545"] = "Hornet 5-1: BRC is 346, so when mother comes to 256 on the nose…\n",
	["DictKey_ActionText_546"] = "Hornet 5-1: 30 degrees left bank, intercept BRC.\n",
	["DictKey_ActionText_547"] = "Hornet 5-2: Got it.\n",
	["DictKey_ActionText_548"] = "Hornet 5-1: Final 12 NM corridor, 12 hundred AGL, 250 ground speed.\n",
	["DictKey_ActionText_549"] = "Hornet 5-1: And fly Bullseye.\n",
	["DictKey_ActionText_55"] = "",
	["DictKey_ActionText_550"] = "Hornet 5-1: 8 NM, gear down.\n",
	["DictKey_ActionText_551"] = "Hornet 5-1: 4 NM, approaching glideslope.",
	["DictKey_ActionText_552"] = "Hornet 5-1: And shit, expect fog.\n",
	["DictKey_ActionText_553"] = "Hornet 5-1: ACLS all the way. Let George do the work.\n",
	["DictKey_ActionText_554"] = "Hornet 5-2: Sounds like a plan.\n",
	["DictKey_ActionText_555"] = "Hornet 5-1: Alright then. Let’s see how it goes.\n",
	["DictKey_ActionText_556"] = "Hornet 5-2: Copy. Coffee’s on you if we trap.\n",
	["DictKey_ActionText_557"] = "",
	["DictKey_ActionText_558"] = "Hornet-5-2: Two, in position.",
	["DictKey_ActionText_561"] = "",
	["DictKey_ActionText_565"] = "Overlord: Hornet-5, Overlord-1-1. Exit the area immediately! Turn North. Switch 251.2 & contact Magic-2.",
	["DictKey_ActionText_567"] = "Magic: Hornet-5, Magic-2-1, prepare for Texaco rendezvous. Do not exit Turkish airspace until refueling is complete.\n\nAnd… congratulations, boys. Solid work. We’ve got it from here.\n",
	["DictKey_ActionText_568"] = "Hornet 5-1: Two, I’m gonna hold 310 knots with a 5 degree climb. Stay on course.",
	["DictKey_ActionText_569"] = "",
	["DictKey_ActionText_57"] = "",
	["DictKey_ActionText_572"] = "Hornet 5-2: You know what, I’m out. I’m not going airline.\n",
